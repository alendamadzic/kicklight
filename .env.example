# Football data: ESPN's public site API needs no key. football-data.org is the optional fallback.
# Get a free key at https://www.football-data.org/client/register
FOOTBALL_DATA_API_KEY=your_key_here

# Hue Remote API app (developers.meethue.com). The callback URL registered there must be
# ${NEXT_PUBLIC_SITE_URL}/api/hue/oauth/callback
HUE_CLIENT_ID=your_hue_client_id
HUE_CLIENT_SECRET=your_hue_client_secret
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Supabase (project settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# 32 random bytes, base64 (openssl rand -base64 32). Encrypts Hue tokens at rest.
HUE_TOKEN_KEY=your_base64_key
# Shared secret that Supabase Cron presents to /api/cron/tick
CRON_SECRET=your_random_secret
# cloud (default) or local (self-hosted on the home network)
KICKLIGHT_MODE=cloud

# Local mode only: stream at 50 Hz over the Entertainment API (needs the bridge paired by Kicklight)
KICKLIGHT_ENTERTAINMENT=0

# Capture raw ESPN payloads into the recordings table (export with scripts/export-recording.ts)
KICKLIGHT_RECORD=0

# Dev only: let `next dev` drive cloud sessions itself (Supabase Cron can't reach localhost).
# Leave off when .env.local points at the production database, or it competes with the live site.
KICKLIGHT_DEV_LOOP=0
