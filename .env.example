# Copy to .env.local and fill in. docs/deploy.md walks through each one.
# Match data needs no keys: ESPN's and FotMob's public APIs are used directly.

# --- Site ---------------------------------------------------------------------
# The public origin. Hue OAuth redirects back to ${NEXT_PUBLIC_SITE_URL}/api/hue/oauth/callback.
NEXT_PUBLIC_SITE_URL=https://your-domain.example
# cloud (default: Vercel + the Hue Remote API) or local (self-hosted on the home network)
KICKLIGHT_MODE=cloud

# --- Supabase (project settings -> API) ----------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key
# Server only. Bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# --- Hue ------------------------------------------------------------------------
# Remote API app from developers.meethue.com (cloud mode). Its callback URL must be
# ${NEXT_PUBLIC_SITE_URL}/api/hue/oauth/callback
HUE_CLIENT_ID=your_hue_client_id
HUE_CLIENT_SECRET=your_hue_client_secret
# 32 random bytes, base64 (openssl rand -base64 32). Encrypts Hue credentials at rest.
HUE_TOKEN_KEY=your_base64_key

# --- Session loop ---------------------------------------------------------------
# Shared secret that Supabase Cron presents to /api/cron/tick
CRON_SECRET=your_random_secret
# Dev only: let `next dev` drive cloud sessions itself (Supabase Cron can't reach localhost).
# Needs CRON_SECRET. Leave off when .env.local points at the production database, or it
# competes with the live site.
KICKLIGHT_DEV_LOOP=0

# --- Local mode only --------------------------------------------------------------
# Stream at 50 Hz over the Entertainment API (needs the bridge paired by Kicklight)
KICKLIGHT_ENTERTAINMENT=0

# --- Recording ------------------------------------------------------------------
# Capture raw ESPN payloads into the recordings table (export with scripts/export-recording.ts)
KICKLIGHT_RECORD=0
