# Football data: ESPN's public site API needs no key. football-data.org is the optional fallback.
# Get a free key at https://www.football-data.org/client/register
FOOTBALL_DATA_API_KEY=your_key_here

# Hue Remote API app (developers.meethue.com). The callback URL registered there must be
# ${NEXT_PUBLIC_SITE_URL}/api/hue/oauth/callback
HUE_CLIENT_ID=your_hue_client_id
HUE_CLIENT_SECRET=your_hue_client_secret
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Supabase (project settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
